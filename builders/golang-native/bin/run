#!/usr/bin/env python3
"""External builder: run.
Запускает собранный chaincode как процесс, который подключается к peer по mTLS.
Аргументы: <BUILD_OUTPUT_DIR> <RUN_METADATA_DIR>
chaincode.json содержит chaincode_id, peer_address, client_cert, client_key, root_cert, mspid."""
import json, os, sys

build_out, run_dir = sys.argv[1], sys.argv[2]
cfg = json.load(open(os.path.join(run_dir, "chaincode.json")))

env = {
    "PATH": os.environ.get("PATH", "/usr/bin:/bin"),
    "CORE_CHAINCODE_ID_NAME": cfg["chaincode_id"],
    "CORE_PEER_ADDRESS": cfg["peer_address"],
    "CORE_PEER_LOCALMSPID": cfg.get("mspid", ""),
    "CORE_PEER_TLS_ENABLED": "false",
}
if cfg.get("client_cert"):
    files = {"client.crt": cfg["client_cert"], "client.key": cfg["client_key"], "root.crt": cfg["root_cert"]}
    for name, pem in files.items():
        p = os.path.join(run_dir, name)
        fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            f.write(pem)
    env.update({
        "CORE_PEER_TLS_ENABLED": "true",
        "CORE_TLS_CLIENT_CERT_FILE": os.path.join(run_dir, "client.crt"),
        "CORE_TLS_CLIENT_KEY_FILE": os.path.join(run_dir, "client.key"),
        "CORE_PEER_TLS_ROOTCERT_FILE": os.path.join(run_dir, "root.crt"),
    })

binary = os.path.join(build_out, "chaincode")
os.execve(binary, [binary, "-peer.address=" + cfg["peer_address"]], env)
