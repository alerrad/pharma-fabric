#!/usr/bin/env python3
"""External builder: build.
Компилирует Go chaincode из пакета без Docker (аналог fabric-ccenv).
Аргументы: <CHAINCODE_SOURCE_DIR> <CHAINCODE_METADATA_DIR> <BUILD_OUTPUT_DIR>"""
import json, os, shutil, subprocess, sys

src_root, meta_dir, out = sys.argv[1], sys.argv[2], sys.argv[3]
meta = json.load(open(os.path.join(meta_dir, "metadata.json")))
src = os.path.join(src_root, "src")

# Определяем пакет main относительно корня модуля
module = ""
with open(os.path.join(src, "go.mod")) as f:
    for line in f:
        if line.startswith("module "):
            module = line.split()[1]
            break
path = meta.get("path", module)
rel = "." if path == module else "./" + path[len(module):].lstrip("/")

env = dict(os.environ)
env.setdefault("GOCACHE", os.path.join(out, ".gocache"))
env["CGO_ENABLED"] = "0"
mod_flag = "-mod=vendor" if os.path.isdir(os.path.join(src, "vendor")) else "-mod=readonly"
cmd = ["go", "build", "-trimpath", mod_flag, "-o", os.path.join(out, "chaincode"), rel]
print("golang-native builder:", " ".join(cmd), "in", src, flush=True)
subprocess.run(cmd, cwd=src, env=env, check=True)

# Индексы CouchDB и прочие метаданные (если есть) передаются в release
meta_inf = os.path.join(src, "META-INF")
if os.path.isdir(meta_inf):
    shutil.copytree(meta_inf, os.path.join(out, "META-INF"), dirs_exist_ok=True)
shutil.rmtree(os.path.join(out, ".gocache"), ignore_errors=True)
