#!/usr/bin/env python3
"""External builder: detect.
Принимает пакеты chaincode типа golang (peer lifecycle chaincode package --lang golang).
Аргументы: <CHAINCODE_SOURCE_DIR> <CHAINCODE_METADATA_DIR>"""
import json, os, sys

meta = json.load(open(os.path.join(sys.argv[2], "metadata.json")))
sys.exit(0 if meta.get("type", "").lower() == "golang" else 1)
